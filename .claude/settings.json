{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git branch *)",
      "Bash(git fetch *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git switch *)",
      "Bash(git checkout -b *)",
      "Bash(git worktree add *)",
      "Bash(git worktree list *)",
      "Bash(gh issue view *)",
      "Bash(gh issue list *)",
      "Bash(gh pr view *)",
      "Bash(gh pr list *)",
      "Bash(gh pr diff *)",
      "Bash(gh pr checks *)",
      "Bash(gh project item-list *)",
      "Bash(gh project field-list *)",
      "Bash(node scripts/*)",
      "Bash(scripts/check-*)",
      "Bash(./scripts/check-*)",
      "Bash(bash scripts/check-*)",
      "Bash(scripts/test-hooks.sh)",
      "Bash(bash scripts/test-hooks.sh)",
      "Bash(.agents/skills/agent-sop/scripts/validate-sop.sh *)",
      "Bash(bash .agents/skills/agent-sop/scripts/validate-sop.sh *)",
      "Bash(bash .agents/skills/skill-intake/scripts/check-skill.sh *)",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:*.github.com)",
      "WebFetch(domain:raw.githubusercontent.com)",
      "WebFetch(domain:registry.npmjs.org)",
      "WebFetch(domain:www.npmjs.com)",
      "WebFetch(domain:crates.io)",
      "WebFetch(domain:docs.rs)"
    ],
    "ask": [
      "Bash(git push *)",
      "Bash(gh pr create *)",
      "Bash(gh pr merge *)",
      "Bash(gh pr comment *)",
      "Bash(gh issue create *)",
      "Bash(gh issue edit *)",
      "Bash(gh issue close *)",
      "Bash(gh issue comment *)",
      "Bash(gh project item-add *)",
      "Bash(gh project item-edit *)",
      "Bash(git worktree remove *)",
      "Bash(git branch -d *)",
      "Bash(git branch -D *)",
      "Bash(git branch --delete *)",
      "Bash(node scripts/sync-labels.mjs *--apply*)",
      "Bash(npm install *)",
      "Bash(npm i *)",
      "Bash(npm ci *)",
      "Bash(npm add *)",
      "Bash(npx *)",
      "Bash(cargo add *)",
      "Bash(cargo install *)",
      "Bash(curl *)",
      "Bash(wget *)"
    ],
    "deny": [
      "Bash(git push *--force*)",
      "Bash(git push *-f)",
      "Bash(git push *-f *)",
      "Bash(git push +*)",
      "Bash(git push * +*)",
      "Bash(git reset --hard origin/main*)",
      "Bash(git branch -D main)",
      "Bash(git branch --delete --force main)",
      "Bash(git commit *--no-verify*)",
      "Bash(git commit *-n)",
      "Bash(git commit *-n *)",
      "Bash(git config core.hooksPath *)",
      "Bash(git config * core.hooksPath *)",
      "Bash(git config --unset* core.hooksPath*)",
      "Bash(git -c core.hooksPath*)",
      "Bash(npm publish *)",
      "Bash(npm dist-tag *)",
      "Bash(npm unpublish *)",
      "Bash(gh repo edit *)",
      "Bash(gh repo delete *)",
      "Bash(gh api *-X DELETE*)",
      "Bash(gh api *-XDELETE*)",
      "Bash(gh api *--method DELETE*)",
      "Bash(gh api *--method=DELETE*)",
      "Bash(rm -r *)",
      "Bash(rm -R *)",
      "Bash(rm -rf *)",
      "Bash(rm -fr *)",
      "Bash(rm -Rf *)",
      "Bash(rm -fR *)",
      "Bash(rm --recursive *)",
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.*.local)",
      "Read(**/.env.development)",
      "Read(**/.env.production)",
      "Read(**/.env.test)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/id_rsa)",
      "Read(**/id_dsa)",
      "Read(**/id_ecdsa)",
      "Read(**/id_ed25519)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.npmrc)",
      "Read(~/.config/gh/hosts.yml)",
      "Read(~/.git-credentials)"
    ]
  }
}
